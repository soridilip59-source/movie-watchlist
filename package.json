  "description": "A RESTful API and Web Dashboard for Family Movie Watchlists with age-appropriate recommendations, family ratings, and watchlist analytics.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run"
  },
  "keywords": [
    "express",
    "typescript",
    "sqlite",
    "watchlist",
    "movies",
    "family",
    "api",
    "swagger"
